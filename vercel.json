{
	"version": 2,
	"builds": [
		{
			"src": "package.json",
			"use": "@vercel/static-build",
			"config": {
				"distDir": "dist"
			}
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "/index.html"
		}
	],
	"env": {
		"VITE_API_URL": "https://voter-backend-d2204486ce63.herokuapp.com/api/votes",
		"VITE_EMAIL_API_URL": "https://voter-backend-d2204486ce63.herokuapp.com/api/email"
	}
}
